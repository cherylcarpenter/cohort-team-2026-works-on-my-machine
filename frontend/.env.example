NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server only. Never add NEXT_PUBLIC_ to these names.
BROWSER_USE_API_KEY=
# Optional document-reading fallback for scanned PDFs/images and incomplete text extraction.
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
SUPABASE_SECRET_KEY=
# Alternatively, use a legacy Supabase service-role key:
# SUPABASE_SERVICE_ROLE_KEY=

# Server only. Set DEMO_MODE=true to accept only the three sample bills.
DEMO_MODE=
# Optional plain-text login hint shown on the sign-in page in demo mode.
DEMO_LOGIN_HINT=
